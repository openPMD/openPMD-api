#!/usr/bin/env python3
"""Check output filenames used by tests and examples.

Tests and examples that write data files should follow two rules:

1. Output files must be written below ``../samples``. Test binaries and
   examples are run by CTest with the build directory as working directory, so
   ``../samples`` refers to ``<build>/samples``. Keeping generated data there
   keeps the build directory tidy and groups all sample data in one place.
2. No output filename may be used by more than one source file. CTest runs the
   test executables and examples in parallel, so two of them writing the same
   file would race and clobber each other's data.

The check is purely static: it looks for string literals passed to functions
that open a series for writing (``Series``/``IO`` constructors, ``fstream``
output files, ...).

@result 0 if no violation is found, else 1
"""

import os
import re
import sys

# file extensions used by the openPMD backends and their configuration
EXTENSIONS = (
    "h5",
    "hdf5",
    "bp",
    "bp3",
    "bp4",
    "bp5",
    "sst",
    "json",
    "toml",
)

# A string literal ending in one of the extensions above. Trailing whitespace
# inside the quotes is allowed for the config-file syntax (`"@../samples/x"`).
LITERAL = re.compile(r'"([^"]*?\.(?:' + "|".join(EXTENSIONS) + r'))\s*"')

# Heuristics for "this filename is opened for writing".
WRITE_HINT = re.compile(
    r"Access::CREATE"
    r"|Access::WRITE"
    r"|Access::APPEND"
    r"|AccessType::CREATE"
    r"|io\.Access\.create"
    r"|Access\.create"
    r"|Access_Type\.create"
    r"|create_linear"
    r"|create_random"
    r"|Mode::Write"
    r"|ios_base::out"
    r"|ios::out"
    r"|std::ofstream"
)

# Literals that only name a file extension (used as an argument to the IO
# handler in unit tests), not an output file.
EXTENSION_ONLY = re.compile(r"\.\w+$")

# The co-load reproducer is a stand-alone diagnostic script, not part of the
# regular test or example suite.
IGNORE_FILES = {os.path.join("test", "python", "coload_repro.py")}

SOURCE_DIRS = ("examples", "test")


def source_files(root):
    for base in SOURCE_DIRS:
        for dirpath, _, filenames in os.walk(os.path.join(root, base)):
            for filename in filenames:
                if filename.endswith((".cpp", ".hpp", ".py")):
                    yield os.path.relpath(
                        os.path.join(dirpath, filename), root
                    )


def normalize(path):
    """Strip the config-file prefix (``@``) and surrounding whitespace."""
    path = path.strip()
    if path.startswith("@"):
        path = path[1:].strip()
    return path


def main():
    root = os.path.abspath(sys.argv[1] if len(sys.argv) > 1 else os.getcwd())
    os.chdir(root)

    outputs = {}
    for filename in sorted(source_files(root)):
        if filename in IGNORE_FILES:
            continue
        with open(filename, errors="replace") as handle:
            lines = handle.read().splitlines()
        for index, line in enumerate(lines):
            for match in LITERAL.finditer(line):
                literal = match.group(1)
                if EXTENSION_ONLY.fullmatch(literal):
                    continue
                # Look for a write access in the statement the literal is part
                # of. A small window is used to also catch wrapped statements.
                window = "\n".join(
                    lines[max(0, index - 1) : index + 4]
                )
                if not WRITE_HINT.search(window):
                    continue
                path = normalize(literal)
                outputs.setdefault(path, set()).add(filename)

    ok = 0

    wrong_location = sorted(p for p in outputs if not p.startswith("../samples"))
    if wrong_location:
        ok = 1
        print("# Output files not written below ../samples:")
        for path in wrong_location:
            print(f"#   {path}")
            for filename in sorted(outputs[path]):
                print(f"#       {filename}")

    duplicates = sorted(
        path for path, files in outputs.items() if len(files) > 1
    )
    if duplicates:
        ok = 1
        print("# Output filenames used by more than one source file:")
        for path in duplicates:
            print(f"#   {path}")
            for filename in sorted(outputs[path]):
                print(f"#       {filename}")

    if ok:
        print("#")
        print("# SUMMARY")
        print("# -------")
        print("# Write output files below ../samples and give each one a unique")
        print("# name so that parallel test runs do not race.")

    return ok


if __name__ == "__main__":
    sys.exit(main())
